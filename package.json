{
  "name": "kfupm-pre-arrival-compliance-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p functions",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run validate:terms",
    "validate:terms": "node --experimental-strip-types scripts/validate-terms.ts",
    "release:check": "npm run verify && npm run validate:terms -- --strict && npm run build",
    "dev:api": "wrangler pages dev --port 8788 --ip 127.0.0.1 --inspector-port 0",
    "db:migrate:local": "wrangler d1 migrations apply pacf-roster --local && wrangler d1 migrations apply pacf-records --local",
    "db:migrate:remote": "wrangler d1 migrations apply pacf-roster --remote && wrangler d1 migrations apply pacf-records --remote",
    "serve:test": "npm run build && npm run db:migrate:local && npm run db:seed:local && npm run dev:api",
    "roster:import": "node --experimental-strip-types scripts/roster-import.ts",
    "db:seed:local": "node --experimental-strip-types scripts/roster-import.ts data/roster.sample.csv && node --experimental-strip-types scripts/roster-import.ts data/roster.e2e.csv",
    "data:export": "node --experimental-strip-types scripts/data-export.ts"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.2.1",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "signature_pad": "^5.1.4",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
