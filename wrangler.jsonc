{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kfupm-beach-compliance-portal",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // No databases or buckets: nothing is stored. Non-secret settings only; the one secret (RESEND_API_KEY) lives in
  // .dev.vars locally and in the Pages project's encrypted variables in production (docs/HANDOVER.md).
  "vars": {
    "EMAIL_MODE": "resend",
    "EMAIL_FROM": "KFUPM Student Affairs <onboarding@resend.dev>",
    "EMAIL_REPLY_TO": "eyadsalem139@gmail.com",
    "EMAIL_BCC": ""
  }
}
