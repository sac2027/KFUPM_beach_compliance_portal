# Cloudflare Workers static assets: https://developers.cloudflare.com/workers/static-assets/headers/
# Rules that match the same path are merged, and a header set by two rules is joined with a comma,
# so Cache-Control is deliberately NOT set on /* (the HTML keeps Cloudflare's default revalidation).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Vite fingerprints these file names, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and brand artwork keep their names: a week, then revalidate.
/fonts/*
  Cache-Control: public, max-age=604800
/brand/*
  Cache-Control: public, max-age=604800
